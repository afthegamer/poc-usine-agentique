{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "*": ["./node_modules/*"],
      "@playwright/test": ["./node_modules/@playwright/test"]
    }
  },
  "files": ["./usine-test/index.d.ts"],
  "include": ["/acceptance/tests/**/*.ts"],
  "exclude": ["/acceptance/tests/non-regression"]
}
